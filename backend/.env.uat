# ============================================================================
# PRODUCTION environment for chat.dishaestate.com
# Generated for this deployment — rename this file to ".env" on the server
# (backend/.env). Never commit this file to git (it's already covered by
# .gitignore's ".env" rule once renamed).
# ============================================================================

# ---- Server ----
PORT=3001
NODE_ENV=production

# ---- MySQL ----
# DB_HOST is a best guess: the DB panel (https://72.60.223.169:8443/) and
# chat.dishaestate.com resolve to the SAME server IP, so MySQL almost
# certainly listens on this same machine. Log into that panel and look for a
# field literally called "Host" / "Server" / "Hostname" next to the dishaCHAT
# database — if it shows anything other than 127.0.0.1 or localhost, replace
# the value below with that instead. See host.md step 3.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dishaCHAT
DB_PASSWORD=XSHvZm7DPszPr50QSPcM
DB_NAME=dishaCHAT
DB_CONNECTION_LIMIT=10

# ---- Auth ----
# Real random secrets, generated specifically for this deployment
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# NOTE: this MUST be named JWT_ACCESS_SECRET (not JWT_SECRET) — the code only
# reads JWT_ACCESS_SECRET (backend/src/config/env.js). Your local dev .env
# currently has this named wrong and has therefore been silently running on
# the insecure default secret — see host.md's "Note" callout.
JWT_SECRET="6fd2f664e8d7467cd6ec0f3577f8990623cfc6dac499120319cd915a45e0f4f3632e48fa1b1555a416d68a9710ad0b07"
JWT_REFRESH_SECRET="3ec0342d4b98c77a2ede3d74809f0cdaaaead694ab7e4839864c571391eda63be2272fcbe6d96aa64c2c8480e3e482b8"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---- CORS ----
# Same-origin requests (chat.dishaestate.com calling itself — the admin app
# and the widget-demo page) never need an entry here; browsers skip CORS for
# same-origin. This list is ONLY for other domains embedding the widget.
# Using * for now (safe here — this API uses Bearer tokens, not cookies, see
# host.md) since the real client site domains aren't known yet. Replace with
# a real comma-separated domain list before onboarding real client sites.
CORS_ALLOWED_ORIGINS=https://chat.dishaestate.com,https://uat.dishaestate.com,https://dishaestate.com,http://localhost:5173,http://localhost:5174,http://localhost:5500,http://localhost:3000

# ---- Modules ----
ENABLED_MODULES=verification,inventory

