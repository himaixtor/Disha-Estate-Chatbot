# ---- Server ----
PORT=5002
NODE_ENV=development

# ---- MySQL (disha-chatbot database) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=disha-chatbot
DB_CONNECTION_LIMIT=10

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---- CORS ----
# Comma-separated list of origins allowed to call this API in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Modules (blueprint § Module architecture) ----
# Comma-separated: verification, inventory, ai
# "ai" is intentionally left out by default — Release 2.
ENABLED_MODULES=verification,inventory

# ---- Verification module: WhatsApp OTP ----
# Leave WHATSAPP_API_URL/TOKEN empty to use the console channel (logs the OTP
# to the server console instead of sending it) for local development.
# Provider contract (confirmed): POST {WHATSAPP_API_URL}, Authorization:
# Bearer {WHATSAPP_API_TOKEN}, body { messaging_product, whatsapp_no, to,
# type: "template", template: { name: "track_package", language: { code } } }
# — see backend/src/modules/verification/WhatsAppOtpChannel.js.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# The business's own registered WhatsApp number (sent as "whatsapp_no").
WHATSAPP_SENDER_ID=

# ---- Inventory module ----
# Release 1 always uses the mock provider; set once Disha's real API is delivered.
INVENTORY_API_URL=
INVENTORY_API_KEY=
INVENTORY_RESULTS_BASE_URL=https://disha-estate-management.vercel.app/property

# ---- License protection ----
# license.txt is AES-256-GCM authenticated-encrypted with this key (any string
# works — it's hashed to 32 bytes). Set a real random value in production;
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_ENCRYPTION_KEY=change-me-license-key
# Defaults to backend/storage/license.txt — override to relocate it.
LICENSE_FILE_PATH=
